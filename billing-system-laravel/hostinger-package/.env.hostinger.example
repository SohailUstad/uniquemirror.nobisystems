# Copy to the private app directory as .env and fill values in hPanel/SSH.
# Never upload this template populated with real credentials to public_html.
APP_NAME="Billing System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Hostinger Web uses MariaDB. Use database name/user/host from hPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Keep the Spring JWT signing secret if existing mobile/web tokens must continue working.
LEGACY_JWT_SECRET=CHANGE_ME
LEGACY_JWT_EXPIRATION_MS=86400000

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
# Configure SMTP from the mailbox provider before enabling OTP email flows:
# MAIL_MAILER=smtp
# MAIL_HOST=CHANGE_ME
# MAIL_PORT=587
# MAIL_USERNAME=CHANGE_ME
# MAIL_PASSWORD=CHANGE_ME
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="no-reply@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

AI_API_KEY=
AI_API_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the service account private key with literal \n between PEM lines.
FCM_PRIVATE_KEY=
